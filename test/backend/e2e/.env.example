# Base URL of the deployed API Gateway (no trailing slash)
# Find this in the Terraform output: `apigateway_endpoint`
# Example: https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com
API_URL=

# A CORS origin that the API is configured to allow.
# Used as the Origin header in test requests to verify CORS behaviour.
TEST_ORIGIN=http://localhost:5173
